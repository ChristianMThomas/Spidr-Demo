{
  "expo": {
    "name": "Spidr",
    "slug": "spidr-mobile",
    "version": "1.9.0",
    "orientation": "portrait",
    "scheme": "spidr",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinitetechteam.spidr",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "voip"],
        "NSMicrophoneUsageDescription": "Spidr needs the microphone for voice and video calls.",
        "NSCameraUsageDescription": "Spidr needs the camera for video calls."
      }
    },
    "android": {
      "package": "com.infinitetechteam.spidr",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-audio",
      "@react-native-firebase/app",
      "@config-plugins/react-native-webrtc",
      [
        "@config-plugins/react-native-callkeep"
      ]
    ],
    "extra": {
      "apiUrl": "https://cooperative-simplicity-production-bb44.up.railway.app",
      "authUrl": "https://auth.spidrapp.infinitetechteam.com",
      "wsUrl": "https://cooperative-simplicity-production-bb44.up.railway.app",
      "spotifyClientId": ""
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
