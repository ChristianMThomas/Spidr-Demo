# Environment files — never commit secrets
.env
.env.*
spidr-server/.env
spidr-auth/.env
spidr-client/.env.development
spidr-client/.env.production
spidr-client/.env.local
spidr-client/.env.staging
# Dotless variants — a file named plain `env` leaked RESEND_API_KEY, MONGO_URI
# and JWT_SECRET in commit 5a49385 because `.env` alone doesn't match it.
env
*.env
env.*

# HARD-EXCLUDE all secret material — Firebase admin service accounts,
# Apple APNs/VoIP keys, distribution certificates, provisioning profiles.
# These grant admin power over prod; NEVER commit under any circumstance.
spidr-secure/
**/spidr-secure/
*firebase-adminsdk*.json
*serviceAccount*.json
AuthKey_*.p8
*.p8
*.p12
*.mobileprovision
*.keystore

